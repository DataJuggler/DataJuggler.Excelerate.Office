<Project Sdk="Microsoft.NET.Sdk">

  <!-- This is an umbrella project that gathers dependencies for dotnet pack -->
  
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <PackageId>DataJuggler.Excelerate.Office</PackageId>
    <OutputPath>..\solution\$(Configuration)\</OutputPath>
    <PublishPath>..\publish\</PublishPath>  
    <IncludeAllProjectOutputsInPackage>false</IncludeAllProjectOutputsInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\main\NPOI.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\ooxml\NPOI.OOXML.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\openxml4Net\NPOI.OpenXml4Net.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\OpenXmlFormats\NPOI.OpenXmlFormats.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Enums.NET" />
    <PackageReference Include="ExtendedNumerics.BigDecimal" />
    <PackageReference Include="MathNet.Numerics.Signed" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <!-- Build-time only. Without PrivateAssets it is written into the nuspec as a consumer dependency. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="SharpZipLib" />
    <PackageReference Include="SkiaSharp" ExcludeAssets="runtime" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" ExcludeAssets="runtime" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="ZString" />
  </ItemGroup>

  <PropertyGroup>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <_MainAssembly Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.Core.dll">
      <TargetPath>DataJuggler.Excelerate.Office.Core.dll</TargetPath>
    </_MainAssembly>
    <_MainAssembly Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OOXML.dll">
      <TargetPath>DataJuggler.Excelerate.Office.OOXML.dll</TargetPath>
    </_MainAssembly>
    <_MainAssembly Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OpenXml4Net.dll">
      <TargetPath>DataJuggler.Excelerate.Office.OpenXml4Net.dll</TargetPath>
    </_MainAssembly>
    <_MainAssembly Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OpenXmlFormats.dll">
      <TargetPath>DataJuggler.Excelerate.Office.OpenXmlFormats.dll</TargetPath>
    </_MainAssembly>
    <_MainAssembly Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.Core.pdb">
      <TargetPath>DataJuggler.Excelerate.Office.Core.pdb</TargetPath>
    </_MainAssembly>
    <_MainAssembly Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OOXML.pdb">
      <TargetPath>DataJuggler.Excelerate.Office.OOXML.pdb</TargetPath>
    </_MainAssembly>
    <_MainAssembly Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OpenXml4Net.pdb">
      <TargetPath>DataJuggler.Excelerate.Office.OpenXml4Net.pdb</TargetPath>
    </_MainAssembly>
    <_MainAssembly Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OpenXmlFormats.pdb">
      <TargetPath>DataJuggler.Excelerate.Office.OpenXmlFormats.pdb</TargetPath>
    </_MainAssembly>
    <_MainAssembly Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.Core.xml">
      <TargetPath>DataJuggler.Excelerate.Office.Core.xml</TargetPath>
    </_MainAssembly>
    <_MainAssembly Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OOXML.xml">
      <TargetPath>DataJuggler.Excelerate.Office.OOXML.xml</TargetPath>
    </_MainAssembly>
    <_MainAssembly Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OpenXml4Net.xml">
      <TargetPath>DataJuggler.Excelerate.Office.OpenXml4Net.xml</TargetPath>
    </_MainAssembly>
    <_MainAssembly Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OpenXmlFormats.xml">
      <TargetPath>DataJuggler.Excelerate.Office.OpenXmlFormats.xml</TargetPath>
    </_MainAssembly>
  </ItemGroup>

  <ItemGroup>
    <BuildOutputInPackage Include="@(_MainAssembly)" TargetFramework="$(TargetFramework)" />
  </ItemGroup>

</Project>
