<Project Sdk="Microsoft.NET.Sdk">

  <!-- This is an umbrella project that gathers dependencies for dotnet pack -->
  
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <PackageId>DataJuggler.Excelerate.Office</PackageId>
    <GeneratePackageOnBuild Condition=" '$(Configuration)' == 'Release' ">true</GeneratePackageOnBuild>
    <OutputPath>..\solution\$(Configuration)\</OutputPath>
    <PublishPath>..\publish\</PublishPath>  
    <IncludeAllProjectOutputsInPackage>false</IncludeAllProjectOutputsInPackage>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\main\NPOI.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\ooxml\NPOI.OOXML.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\openxml4Net\NPOI.OpenXml4Net.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\OpenXmlFormats\NPOI.OpenXmlFormats.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Enums.NET" />
    <PackageReference Include="ExtendedNumerics.BigDecimal" />
    <PackageReference Include="MathNet.Numerics.Signed" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <!-- Build-time only. Without PrivateAssets it is written into the nuspec as a consumer dependency. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="SharpZipLib" />
    <PackageReference Include="SkiaSharp" ExcludeAssets="runtime" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" ExcludeAssets="runtime" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="ZString" />
  </ItemGroup>

  <PropertyGroup>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <!-- Only these files go in the package. IncludeBuildOutput is off so the placeholder NPOI.Pack.dll is left out. -->
  <ItemGroup>
    <None Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.Core.dll" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
    <None Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.Core.pdb" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
    <None Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.Core.xml" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
    <None Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OOXML.dll" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
    <None Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OOXML.pdb" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
    <None Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OOXML.xml" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
    <None Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OpenXml4Net.dll" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
    <None Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OpenXml4Net.pdb" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
    <None Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OpenXml4Net.xml" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
    <None Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OpenXmlFormats.dll" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
    <None Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OpenXmlFormats.pdb" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
    <None Include="..\solution\$(Configuration)\$(TargetFramework)\DataJuggler.Excelerate.Office.OpenXmlFormats.xml" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
  </ItemGroup>

</Project>
